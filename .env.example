DATA_ROOT=/app/backend/data
METADATA_STORE=sqlite
SQLITE_PATH=/app/backend/data/metadata.db
SQLITE_BUSY_TIMEOUT_MS=5000
WORKER_LEASE_SECONDS=60
WORKER_HEARTBEAT_INTERVAL_SECONDS=20
AUTO_PIPELINE_ENABLED=true
AUTO_PIPELINE_INTERVAL_SECONDS=10
INPROCESS_WORKERS_ENABLED=false
NOTIFICATION_ROBOT_ENABLED=true
NOTIFICATION_ROBOT_INTERVAL_SECONDS=30
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AUTH_ENABLED=false
AUTH_TRUSTED_HEADER_ENABLED=false
OIDC_ISSUER_URL=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
